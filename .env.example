# Copy to .env and adjust. Real environment variables (e.g. systemd
# Environment=) take precedence over values in .env.

# CUPS queue name (required, see SETUP.md)
PRINTER_NAME=your_printer_queue

# Target of the "Home" button in the top bar; leave empty to hide it
HOME_URL=

# milessic-themes server origin (styles are loaded from it)
STYLES_URL=http://mbs.local:9312
